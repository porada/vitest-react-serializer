{
	"name": "vitest-react-serializer",
	"version": "1.2.0",
	"description": "Serialize React components into formatted HTML",
	"license": "MIT",
	"author": {
		"name": "Dom Porada",
		"email": "dom@dom.engineering",
		"url": "https://dom.engineering"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/porada/vitest-react-serializer.git"
	},
	"keywords": [
		"component-testing",
		"html",
		"jsx",
		"react",
		"serializer",
		"snapshot",
		"snapshot-testing",
		"vitest"
	],
	"files": [
		"dist/**"
	],
	"type": "module",
	"sideEffects": false,
	"exports": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@12.16.1",
	"dependencies": {
		"@wasm-fmt/web_fmt": "~0.2.9"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19",
		"vitest": ">=4"
	},
	"devDependencies": {
		"@standard-config/oxlint": "^2.11.1",
		"@standard-config/oxlint-react": "^2.11.1",
		"@standard-config/oxlint-stylistic": "^2.11.1",
		"@standard-config/prettier": "^1.22.0",
		"@standard-config/tsconfig": "^3.2.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/browser-playwright": "^5.1.0",
		"@vitest/coverage-v8": "^5.1.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"publint": "^0.3.25",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^6.0.3",
		"vite-plus": "^1.5.0",
		"vitest": "^5.1.0"
	},
	"scripts": {
		"build": "vp pack",
		"fix": "pnpm format && pnpm lint && pnpm format",
		"format": "prettier --ignore-unknown --log-level=warn --write .",
		"format:check": "prettier --check --ignore-unknown .",
		"lint": "vp lint --fix",
		"lint:check": "vp lint --deny-warnings --type-check",
		"prepack": "pnpm run '/^(format:check|lint:check|test:node|typecheck)$/' && pnpm build",
		"prepare": "vp config --hooks-dir .hooks",
		"test": "vitest run",
		"test:node": "vitest run --project node",
		"typecheck": "tsc --noEmit"
	}
}
